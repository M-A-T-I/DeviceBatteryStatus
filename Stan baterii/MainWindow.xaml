<Window x:Class="Stan_baterii.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatteryWidget" Height="100" Width="100"
        WindowStyle="None" Topmost="True" 
        AllowsTransparency="True" Background="#333333">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ToggleAppMenuItem" 
                      Header="Pokaż aplikację" 
                      IsCheckable="True" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Image x:Name="BatteryImage" Stretch="Fill"/>
    </Grid>
</Window>
