<Window x:Class="Stan_baterii.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stan baterii" 
        Height="60" Width="180" 
        MinHeight="40" MinWidth="120"
        WindowStyle="None" AllowsTransparency="True" Background="#181818"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Topmost="True" 
        ResizeMode="CanResizeWithGrip">
    <!-- Zmieniono tryb zmiany rozmiaru -->

    <!-- Viewbox odpowiada za wektorowe, bezstratne skalowanie -->
    <Viewbox Stretch="Uniform">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock x:Name="BatteryText"
                           Text="--%"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Border BorderBrush="#0066FF"
                            BorderThickness="1.5"
                            Width="50"
                            Height="24"
                            CornerRadius="1"
                            Padding="2"
                            Background="#181818">

                        <Rectangle x:Name="BatteryFill"
                                   Fill="#00FF87"
                                   HorizontalAlignment="Left"
                                   Width="0"/>
                    </Border>

                    <Border BorderBrush="#0066FF"
                            BorderThickness="0,1.5,1.5,1.5"
                            Background="#181818"
                            Width="3"
                            Height="10"
                            CornerRadius="0,1,1,0"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Viewbox>

</Window>